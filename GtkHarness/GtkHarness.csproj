<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GtkHarness</RootNamespace>
    <!-- Same trim/AOT discipline as the Windows harness: the UI tree is drawn by SkiaSharp into a
         Cairo image surface, so nothing here depends on reflection or serializers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The Skia surface is created directly over Cairo's pixel buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
    <ProjectReference Include="..\XPlatUIDemo\XPlatUIDemo.csproj" />
    <ProjectReference Include="..\XPlatUI.Backend.Gtk4\XPlatUI.Backend.Gtk4.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SkiaSharp itself only ships Win32/macOS natives; the Linux one is a separate package. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
  </ItemGroup>

</Project>