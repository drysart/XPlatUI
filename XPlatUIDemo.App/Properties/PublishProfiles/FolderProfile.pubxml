<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
	<Configuration>Release</Configuration>
	<Platform>Any CPU</Platform>
	<PublishDir>bin\Release\net10.0-windows\publish\win-x64\</PublishDir>
	<PublishProtocol>FileSystem</PublishProtocol>
	<_TargetId>Folder</_TargetId>
	<TargetFramework>net10.0-windows</TargetFramework>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<SelfContained>true</SelfContained>

	<!-- NativeAOT: compile the IL straight to native code, no runtime and no JIT in the output.
		 AOT always trims (the compiler only keeps reachable code), so PublishTrimmed/TrimMode are
		 stated explicitly to make the intent clear and to keep full trimming if AOT is turned off.
		 PublishSingleFile is not used: NativeAOT already emits one self-contained native .exe, and
		 the Skia native library is embedded in it by XPlatUIDemo.App.csproj (see
		 Native/SkiaNativeLoader.cs), so the publish folder holds nothing but the executable and its
		 optional .pdb. -->
	<PublishAot>true</PublishAot>
	<PublishTrimmed>true</PublishTrimmed>
	<TrimMode>full</TrimMode>
	<PublishReadyToRun>false</PublishReadyToRun>

	<!-- Set to false to stop embedding the Skia native library, which puts libSkiaSharp.dll back
		 beside the executable in the publish folder. -->
	<EmbedSkiaSharpNative>true</EmbedSkiaSharpNative>

	<!-- NativeAOT links with the MSVC toolset. When the MSVC environment is already initialized
		 (a Developer PowerShell/Command Prompt for VS, or a CI step that called vcvars64.bat),
		 use it directly instead of the ILCompiler's vswhere-based discovery. -->
	<IlcUseEnvironmentalTools Condition="'$(VCToolsInstallDir)' != '' or '$(VCINSTALLDIR)' != ''">true</IlcUseEnvironmentalTools>
  </PropertyGroup>
</Project>
