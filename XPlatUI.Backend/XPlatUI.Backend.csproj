<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This project exists to turn a target framework into a backend, so it has to offer a framework
         for every supported platform. An application only ever needs the one it runs on, though, and
         a contributor should not have to install the macOS workload to build on Windows, so the
         default is the host's platform and the packing pipeline asks for the whole set by setting
         XPlatUIBackendAllPlatforms. See README.md, "The backend selector". -->
    <TargetFrameworks Condition="'$(XPlatUIBackendAllPlatforms)' == 'true'">net10.0-windows;net10.0-macos;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == '' and $([MSBuild]::IsOSPlatform('windows'))">net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == '' and $([MSBuild]::IsOSPlatform('osx'))">net10.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XPlatUI.Backend</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
  </ItemGroup>

  <!-- Exactly one of these is in any given build. That is the whole point: an application that
       targets net10.0-windows never sees, restores or publishes the other two. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\XPlatUI.Backend.Win32\XPlatUI.Backend.Win32.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <ProjectReference Include="..\XPlatUI.Backend.AppKit\XPlatUI.Backend.AppKit.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\XPlatUI.Backend.Gtk4\XPlatUI.Backend.Gtk4.csproj" />
  </ItemGroup>

</Project>
