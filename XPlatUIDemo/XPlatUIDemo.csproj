<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform neutral on purpose: the very same sample control tree is hosted by the Win32
         harness and by the GTK4 harness, so neither can drift away from the other. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XPlatUI.Demo</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
  </ItemGroup>

</Project>
