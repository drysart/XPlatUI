<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- No Windows Forms / System.Drawing here: the harness is raw Win32 + SkiaSharp so it can be
         published with NativeAOT to prove the library's AOT story end to end. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Single-file AOT publish. NativeAOT emits one native executable, so SkiaSharp's native library
       cannot simply sit next to it: embed a compressed copy in the executable and let
       SkiaNativeLoader (Native/SkiaNativeLoader.cs) extract it on first use. The targets below are
       gated on $(PublishAot) at execution time, because publish-profile properties are not yet
       visible while this file is evaluated; set $(EmbedSkiaSharpNative) to false to keep
       libSkiaSharp.dll as a loose file next to the executable instead. -->
  <UsingTask TaskName="GZipFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var input = File.OpenRead(Source))
        using (var output = File.Create(Destination))
        using (var gzip = new GZipStream(output, CompressionLevel.Optimal))
        {
            input.CopyTo(gzip);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Finds the libSkiaSharp.dll the package graph resolved for this RID and registers the compressed
       copy as an embedded resource. This has to run before CreateManifestResourceNames (which is
       what turns @(EmbeddedResource) into compiler inputs), hence the hook on that target rather
       than on PrepareResourceNames, whose dependencies have already run by then. -->
  <Target Name="_LocateSkiaSharpNative"
          Condition="'$(PublishAot)' == 'true' and '$(EmbedSkiaSharpNative)' != 'false'"
          DependsOnTargets="ResolvePackageAssets"
          BeforeTargets="CreateManifestResourceNames">
    <PropertyGroup>
      <!-- IntermediateOutputPath is only known at execution time, so the archive path is computed here. -->
      <SkiaSharpNativeArchive>$(IntermediateOutputPath)native\libSkiaSharp.dll.gz</SkiaSharpNativeArchive>
    </PropertyGroup>
    <ItemGroup>
      <_SkiaSharpNativeLibrary Include="@(NativeCopyLocalItems)"
                               Condition="'%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'libSkiaSharp.dll'" />
    </ItemGroup>
    <Error Condition="'@(_SkiaSharpNativeLibrary)' == ''"
           Text="Could not find libSkiaSharp.dll among the resolved native assets, so it cannot be embedded in the executable." />
    <ItemGroup>
      <!-- Type/WithCulture are what CreateManifestResourceNames and _GenerateCompileInputs key off;
           without them the SDK drops non-resx resources on the floor. -->
      <EmbeddedResource Include="$(SkiaSharpNativeArchive)" LogicalName="XPlatUI.Native.libSkiaSharp.dll.gz">
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="_CompressSkiaSharpNative"
          Condition="'$(PublishAot)' == 'true' and '$(EmbedSkiaSharpNative)' != 'false'"
          DependsOnTargets="_LocateSkiaSharpNative"
          BeforeTargets="CreateManifestResourceNames"
          Inputs="@(_SkiaSharpNativeLibrary->'%(FullPath)')"
          Outputs="$(SkiaSharpNativeArchive)">
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <GZipFile Source="@(_SkiaSharpNativeLibrary->'%(FullPath)')" Destination="$(SkiaSharpNativeArchive)" />
  </Target>

  <!-- The library now lives inside the executable, so keep it (and the debug symbols) out of the
       publish directory; what is left is a single self-contained file. -->
  <Target Name="_ExcludeSkiaSharpNativeFromPublish"
          Condition="'$(PublishAot)' == 'true' and '$(EmbedSkiaSharpNative)' != 'false'"
          AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libSkiaSharp.dll' or '%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>