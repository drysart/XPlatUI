<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XPlatUI</RootNamespace>
    <!-- The library must stay trim/AOT friendly: no reflection, no serializers, no dynamic. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <!-- The application model's container. Referenced here so IServiceCollection and every
         ecosystem package's Add* extension arrive transitively; apps add nothing (D11). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

</Project>
